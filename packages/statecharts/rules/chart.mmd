---
title: "Rules and limits"
---
stateDiagram-v2
  direction LR
  state "At the same time" as all {
    state "Refund rule" as r0 {
      s0: On
      s1: Off
      [*] --> s0
      s0 --> s1: you switch the refund rule
      s1 --> s0: you switch the refund rule
    }
    --
    state "Monday rule" as r1 {
      s2: Off
      s3: On
      [*] --> s2
      s2 --> s3: you switch the Monday rule
      s3 --> s2: you switch the Monday rule
    }
    --
    state "Refund limit" as r2 {
      s4: #36;50
      s5: #36;0
      [*] --> s4
      s4 --> s5: the refund limit is saved [when New rule is none of Adding, Waiting for the read and Save is Saving a limit]
      s5 --> s4: the refund limit is saved [when New rule is none of Adding, Waiting for the read and Save is Saving a limit]
    }
    --
    state "Ad cap" as r3 {
      s6: #36;200
      s7: #36;0
      [*] --> s6
      s6 --> s7: the ad cap is saved [when New rule is none of Adding, Waiting for the read and Save is Saving a limit]
      s7 --> s6: the ad cap is saved [when New rule is none of Adding, Waiting for the read and Save is Saving a limit]
    }
    --
    state "Reorder limit" as r4 {
      s8: #36;500
      [*] --> s8
    }
    --
    state "New rule" as r5 {
      s9: Empty action
      s10: Action typed
      s11: Adding
      s12: Waiting for the read
      s13: Added, on
      s14: Added, typed again
      s15: Saved row stays
      [*] --> s9
      s9 --> s10: you type an action
      s10 --> s11: you add the rule [when Save is Idle]
      s11 --> s10: the add fails or the add is late
      s11 --> s12: the add is saved
      s11 --> s14: the add is saved
      s12 --> s13: the read confirms the row
      s12 --> s14: you type an action
      s12 --> s15: the read times out
      s13 --> s14: you type an action
      s15 --> s13: the read confirms the row [when Save is Saved row stays]
      s15 --> s14: you type an action
    }
    --
    state "Save" as r6 {
      s16: Idle
      s17: Saving a limit
      s18: Adding
      s19: Waiting for the read
      s20: Saved row stays
      [*] --> s16
      s16 --> s17: you move the refund limit or you move the ad cap
      s16 --> s18: you add the rule [when New rule is Action typed]
      s17 --> s16: the refund limit fails or the refund limit is late or the refund limit is saved or the ad cap fails or the ad cap is late or the ad cap is saved [when New rule is not Saved row stays]
      s18 --> s16: the add fails or the add is late
      s18 --> s19: the add is saved
      s19 --> s16: the read confirms the row
      s19 --> s20: the read times out
      s20 --> s16: the read confirms the row
      s20 --> s17: you move the refund limit or you move the ad cap
      s17 --> s20: the refund limit fails or the refund limit is late or the refund limit is saved or the ad cap fails or the ad cap is late or the ad cap is saved [when New rule is one of Added, typed again, Saved row stays]
    }
  }
