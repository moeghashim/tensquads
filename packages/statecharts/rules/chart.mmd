---
title: "Rules and limits"
---
stateDiagram-v2
  direction LR
  state "At the same time" as all {
    state "Refund rule" as r0 {
      s0: On
      s1: Off
      [*] --> s0
      s0 --> s1: you switch the refund rule
      s1 --> s0: you switch the refund rule
    }
    --
    state "Monday rule" as r1 {
      s2: Off
      s3: On
      [*] --> s2
      s2 --> s3: you switch the Monday rule
      s3 --> s2: you switch the Monday rule
    }
    --
    state "Refund limit" as r2 {
      s4: #36;50
      s5: #36;0
      [*] --> s4
      s4 --> s5: the refund limit is saved [when New rule is none of Adding, One read and Save is Saving a limit]
      s5 --> s4: the refund limit is saved [when New rule is none of Adding, One read and Save is Saving a limit]
    }
    --
    state "Ad cap" as r3 {
      s6: #36;200
      s7: #36;0
      [*] --> s6
      s6 --> s7: the ad cap is saved [when New rule is none of Adding, One read and Save is Saving a limit]
      s7 --> s6: the ad cap is saved [when New rule is none of Adding, One read and Save is Saving a limit]
    }
    --
    state "Reorder limit" as r4 {
      s8: #36;500
      [*] --> s8
    }
    --
    state "New rule" as r5 {
      s9: Empty action
      s10: Action typed
      s11: Adding
      s12: One read
      s13: Added, on
      s14: Added, typed again
      [*] --> s9
      s9 --> s10: you type an action
      s10 --> s11: you add the rule [when Save is Idle]
      s9 --> s12: the refund limit fails or the refund limit is late or the ad cap fails or the ad cap is late [when Save is Saving a limit]
      s11 --> s12: the add fails or the add is late
      s11 --> s13: the add returns the row
      s12 --> s9: the read fails and the wait stops or the read returns the snapshot
      s10 --> s12: the refund limit fails or the refund limit is late or the ad cap fails or the ad cap is late [when Save is Saving a limit]
      s11 --> s14: the add returns the row
      s12 --> s10: the read fails and the wait stops or the read returns the snapshot
      s13 --> s14: you type an action
    }
    --
    state "Save" as r6 {
      s15: Idle
      s16: Saving a limit
      s17: Adding
      s18: Waiting for one read
      [*] --> s15
      s15 --> s16: you move the refund limit or you move the ad cap
      s15 --> s17: you add the rule [when New rule is Action typed]
      s16 --> s15: the refund limit is saved or the ad cap is saved
      s16 --> s18: the refund limit fails or the refund limit is late or the ad cap fails or the ad cap is late
      s17 --> s18: the add fails or the add is late
      s17 --> s15: the add returns the row
      s18 --> s15: the read fails and the wait stops or the read returns the snapshot
    }
  }
