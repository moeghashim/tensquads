{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tensquads",
	// Project account. Deploy only through scripts/deploy-cloudflare.mjs.
	"account_id": "678c5a795f40f7e9f33b8a71248cc829",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
	// Phase 4 keeps one Worker. The class and the queue are declared here.
	// Do not create the queue from this repository. Production stays on the test adapters.
	"main": "src/worker.ts",
	"vars": {
		"ADAPTERS": "test",
		"BUS_DEAD_LETTER": "tensquads-bus-dlq",
		"CLERK_PLATFORM_ORG_ID": "org_3Lazia1HC1hdgfY0mAttb1qTWYm"
	},
	"durable_objects": {
		"bindings": [{ "name": "ACCOUNT_BUS", "class_name": "AccountBus" }]
	},
	"migrations": [{ "tag": "v1-account-bus", "new_sqlite_classes": ["AccountBus"] }],
	"queues": {
		"producers": [{ "binding": "BUS_QUEUE", "queue": "tensquads-bus" }],
		"consumers": [
			{ "queue": "tensquads-bus", "max_retries": 3, "dead_letter_queue": "tensquads-bus-dlq" },
			{ "queue": "tensquads-bus-dlq" }
		]
	},
	"observability": {
		"enabled": true
	},
	// The real environment is not production. Production deploy stays `wrangler deploy` with no --env.
	// The real deploy script passes `--env real`. Vars, durable objects, queues, and the browser
	// binding are not inherited, so this environment declares its own. Its queues are
	// tensquads-real-bus and tensquads-real-bus-dlq. The Worker name is tensquads-real.
	// MASTER_MODEL is gpt-6-luna and MASTER_REASONING_EFFORT is medium. The code has no model default.
	// BOAT_PROFILE and BOAT_SECRET_BASE_URL are not secrets. Secret names are listed in
	// real-secrets.json. OPENAI_API_KEY and the other secrets stay out of this file.
	// Browser Rendering is bound only here.
	"env": {
		"real": {
			"vars": {
				"ADAPTERS": "real",
				"BOAT_PROFILE": "tensquads-agents",
				"BOAT_SECRET_BASE_URL": "https://tensquads-real.moe-678.workers.dev",
				"BUS_DEAD_LETTER": "tensquads-real-bus-dlq",
				"CLERK_PLATFORM_ORG_ID": "org_3Lazia1HC1hdgfY0mAttb1qTWYm",
				"MASTER_MODEL": "gpt-6-luna",
				"MASTER_REASONING_EFFORT": "medium"
			},
			"durable_objects": {
				"bindings": [{ "name": "ACCOUNT_BUS", "class_name": "AccountBus" }]
			},
			"migrations": [{ "tag": "v1-account-bus-real", "new_sqlite_classes": ["AccountBus"] }],
			"queues": {
				"producers": [{ "binding": "BUS_QUEUE", "queue": "tensquads-real-bus" }],
				"consumers": [
					{ "queue": "tensquads-real-bus", "max_retries": 3, "dead_letter_queue": "tensquads-real-bus-dlq" },
					{ "queue": "tensquads-real-bus-dlq" }
				]
			},
			"browser": { "binding": "BROWSER" },
			"triggers": { "crons": ["* * * * *"] }
		}
	}
}
